@model BaryoDev.Umbraco.PostAlerts.UnsubscribePage
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Unsubscribe</title>
    <link rel="stylesheet" href="@Url.Content("~/App_Plugins/BaryoDev.PostAlerts/post-alerts.css")" />
</head>
<body class="bdpa-page">
<main class="bdpa-page__box">
    <h1 class="bdpa-page__title">Unsubscribe</h1>
    <p class="bdpa-page__text">Press the button to stop the emails. Your address is deleted from this site.</p>
    <form method="post" action="@Url.Content("~/baryo-post-alerts/unsubscribe/" + Uri.EscapeDataString(Model.Token))">
        <p><button type="submit" class="bdpa__btn">Unsubscribe</button></p>
    </form>
    <p><a class="bdpa-page__link" href="@Model.HomeUrl">Keep my subscription</a></p>
</main>
</body>
</html>
