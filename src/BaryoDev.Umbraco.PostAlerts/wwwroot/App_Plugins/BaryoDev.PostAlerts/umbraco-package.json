{
  "$schema": "../../umbraco-package-schema.json",
  "name": "BaryoDev.Umbraco.PostAlerts",
  "version": "0.1.0",
  "allowTelemetry": false,
  "extensions": [
    {
      "type": "dashboard",
      "alias": "BaryoDev.PostAlerts.Dashboard",
      "name": "Post alerts",
      "element": "/App_Plugins/BaryoDev.PostAlerts/post-alerts-dashboard.js",
      "weight": -10,
      "meta": {
        "label": "Post alerts",
        "pathname": "post-alerts"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Umb.Section.Content"
        }
      ]
    }
  ]
}
